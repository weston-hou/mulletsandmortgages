{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "vitest.setup.ts",
    "vitest.config.mts",
    "playwright.config.ts",
    "playwright.smoke.config.ts",
    "playwright.staging.config.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "e2e/**/*.ts",
    "e2e-smoke/**/*.ts",
    "e2e-staging/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
