# =============================================================================
# Mullets & Mortgages — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in the values:
#     cp .env.example .env.local
#
# Every variable below is actually read somewhere in app/ or lib/. Variables are
# grouped by the feature that needs them. The CORE block is the minimum required
# to run the landing form -> rates email funnel locally. Other blocks gate
# specific features and can be left blank until you turn that feature on.
#
# Anything prefixed NEXT_PUBLIC_ is exposed to the browser — never put secrets
# in a NEXT_PUBLIC_ var.
# =============================================================================


# --- CORE: database (Supabase) -----------------------------------------------
# Standard Postgres-backed REST API. Accessed via fetch() in lib/supabase.ts,
# no vendor SDK. Service-role key is server-only; the NEXT_PUBLIC URL is the
# same project URL exposed to the client.
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- CORE: email delivery (Resend) -------------------------------------------
# Sends the rates email and pre-qual letters (lib/email.ts). Swap to any other
# provider by editing that one file.
RESEND_API_KEY=

# --- CORE: app base URL ------------------------------------------------------
# Used to build absolute links in emails/SMS/letters. For local dev use the
# localhost URL; in production set it to the deployed origin.
NEXT_PUBLIC_BASE_URL=http://localhost:3000


# --- SMS + conversational agent (Twilio + Anthropic) -------------------------
# Required for the SMS follow-up agent. Twilio sends/receives texts; Anthropic
# powers the conversational replies and pre-qual field extraction.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
ANTHROPIC_API_KEY=
# Zach's phone — receives lead/handoff notifications via SMS.
ZACH_PHONE=+1XXXXXXXXXX


# --- Admin dashboard + cron --------------------------------------------------
# ADMIN_PASSWORD gates /admin and protected API routes (cookie auth).
# CRON_SECRET is the bearer token Vercel Cron sends to the /api/cron/* and
# /api/agent/* endpoints; generate a long random string.
ADMIN_PASSWORD=change-me
CRON_SECRET=change-me-to-a-long-random-string


# --- Pre-qual letters / document signing -------------------------------------
# DOCUMENT_SIGNING_SECRET signs/verifies document request + sign links
# (app/api/documents/*). Generate a long random string.
DOCUMENT_SIGNING_SECRET=change-me-to-a-long-random-string


# --- OPTIONAL: analytics (PostHog) -------------------------------------------
# Client-side product analytics. App degrades gracefully if unset.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# --- OPTIONAL: Google Drive (content ingestion) ------------------------------
# Used by the admin "upload video" route to push files into Google Drive, which
# the Vizard content pipeline (content-pipeline/) watches. Not required for the
# lead/email/SMS funnel. Full service-account JSON on a single line.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Drive folder ID the Vizard n8n workflow watches. When set, admin uploads go
# straight into it (and are made link-readable) so each file triggers clipping.
# Must be the SAME folder ID you put in the workflow's "Folder to Watch" node.
VIZARD_INTAKE_DRIVE_FOLDER_ID=


# =============================================================================
# NOT environment variables (documented here so you know where they live)
# -----------------------------------------------------------------------------
# Optimal Blue QuickQuote credentials (ClientId/UserId/FormId) are currently
# HARDCODED as constants in app/api/rates/quote/route.ts. If you want them
# configurable, move them into env vars there.
# =============================================================================
