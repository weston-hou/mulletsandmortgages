{
  "name": "Mullets & Mortgages — Content Pipeline",
  "nodes": [
    {
      "id": "google-drive-trigger",
      "name": "Google Drive — New Video",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "__rl": true,
          "value": "REPLACE_WITH_GOOGLE_DRIVE_FOLDER_ID",
          "mode": "id"
        },
        "event": "fileCreated",
        "simplifyOutput": true
      }
    },
    {
      "id": "parse-file",
      "name": "Parse File Metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "jsCode": "// Build a Vizard-readable Google Drive share URL from the Drive trigger.\n// The watched folder must be shared 'anyone with the link can view'.\nconst file = $input.first().json;\nconst fileId = file.id;\nconst fileName = file.name || 'untitled';\nconst driveShareUrl = `https://drive.google.com/file/d/${fileId}/view?usp=sharing`;\nconst title = fileName.replace(/\\.[^/.]+$/, '');\nreturn [{ json: { fileId, fileName, driveShareUrl, title, uploadedAt: new Date().toISOString() } }];"
      }
    },
    {
      "id": "vizard-create",
      "name": "Vizard — Create Project",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "vizard-api-creds",
          "name": "Vizard API"
        }
      },
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "url": "https://elb-api.vizard.ai/hvizard-server-front/open-api/v1/project/create",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const TEMPLATE_ID = 'REPLACE_WITH_VIZARD_TEMPLATE_ID'; const body = { lang: 'en', videoUrl: $json.driveShareUrl, videoType: 3, preferLength: [1,2,3,4], maxClipNumber: 10, ratioOfClip: 1, projectName: $json.title }; if (TEMPLATE_ID && TEMPLATE_ID !== 'REPLACE_WITH_VIZARD_TEMPLATE_ID') body.templateId = Number(TEMPLATE_ID); return JSON.stringify(body); })() }}",
        "options": {}
      }
    },
    {
      "id": "extract-project-id",
      "name": "Extract Project ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst projectId = r.projectId ?? r.data?.projectId;\nif (!projectId) throw new Error('Vizard create failed: ' + JSON.stringify(r));\nreturn [{ json: { projectId } }];"
      }
    },
    {
      "id": "wait-initial",
      "name": "Wait 3 Minutes",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ],
      "webhookId": "vizard-wait-initial",
      "parameters": {
        "amount": 3,
        "unit": "minutes"
      }
    },
    {
      "id": "vizard-query",
      "name": "Vizard — Query Clips",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "vizard-api-creds",
          "name": "Vizard API"
        }
      },
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "GET",
        "url": "=https://elb-api.vizard.ai/hvizard-server-front/open-api/v1/project/query/{{ $json.projectId }}",
        "options": {}
      }
    },
    {
      "id": "clips-ready",
      "name": "Clips Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1560,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-code-2000",
              "leftValue": "={{ $json.code }}",
              "rightValue": 2000,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "wait-retry",
      "name": "Wait 30s & Retry",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        1560,
        520
      ],
      "webhookId": "vizard-wait-retry",
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      }
    },
    {
      "id": "vizard-social-accounts",
      "name": "Vizard — Get Social Accounts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "vizard-api-creds",
          "name": "Vizard API"
        }
      },
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "GET",
        "url": "https://elb-api.vizard.ai/hvizard-server-front/open-api/v1/project/social-accounts",
        "options": {}
      }
    },
    {
      "id": "build-publish-tasks",
      "name": "Build Publish Tasks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        200
      ],
      "parameters": {
        "jsCode": "// Pick the top clips by viral score, then fan out one publish task per\n// (clip x connected social account). Edit MAX_CLIPS / caption / platform\n// filter here to tune what gets posted.\nconst MAX_CLIPS = 5;\n\nconst query = $('Vizard — Query Clips').first().json;\nconst videos = query.videos || [];\nif (!videos.length) throw new Error('No clips returned from Vizard');\n\nconst selected = [...videos]\n  .sort((a, b) => parseFloat(b.viralScore || '0') - parseFloat(a.viralScore || '0'))\n  .slice(0, MAX_CLIPS);\n\nconst accounts = ($input.first().json.publishAccounts || [])\n  .filter(a => a.status === 'active');\n// To target only some platforms, filter here, e.g.:\n// .filter(a => ['TikTok','Instagram','YouTube'].includes(a.platform));\nif (!accounts.length) throw new Error('No active connected social accounts in Vizard');\n\nconst caption = 'New from Mullets & Mortgages \\uD83C\\uDFE0 Free rate quote \\u2192 mulletsandmortgages.com\\n\\n#mortgage #realestate #homebuying #mortgagebroker #firsttimehomebuyer';\n\nconst tasks = [];\nfor (const c of selected) {\n  for (const a of accounts) {\n    tasks.push({ json: {\n      finalVideoId: c.videoId,\n      socialAccountId: a.id,\n      platform: a.platform,\n      title: c.title,\n      post: caption,\n    } });\n  }\n}\nreturn tasks;"
      }
    },
    {
      "id": "vizard-publish",
      "name": "Vizard — Publish Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2220,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "vizard-api-creds",
          "name": "Vizard API"
        }
      },
      "onError": "continueRegularOutput",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "url": "https://elb-api.vizard.ai/hvizard-server-front/open-api/v1/project/publish-video",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ finalVideoId: $json.finalVideoId, socialAccountId: $json.socialAccountId, post: $json.post, title: $json.title }) }}",
        "options": {}
      }
    },
    {
      "id": "aggregate",
      "name": "Aggregate Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2440,
        200
      ],
      "parameters": {
        "jsCode": "// publish-video returns { code: 2000 } on success. Align results with the\n// publish tasks by index to report per-platform status.\nconst tasks = $('Build Publish Tasks').all().map(i => i.json);\nconst results = $input.all().map(i => i.json);\n\nconst lines = results.map((r, idx) => {\n  const t = tasks[idx] || {};\n  const ok = r && r.code === 2000;\n  const status = ok ? 'OK' : `FAIL(${r && r.code}${r && r.errMsg ? ':' + r.errMsg : ''})`;\n  return `${t.platform || '?'} \\u2014 ${status}`;\n});\n\nconst published = results.filter(r => r && r.code === 2000).length;\nconst failed = results.length - published;\n\nconst summary = `\\u2702\\uFE0F Mullets & Mortgages \\u2014 ${published} posts published, ${failed} failed.\\n` +\n  lines.join('\\n') + '\\n\\nmulletsandmortgages.com';\n\nreturn [{ json: { totalPublished: published, totalFailed: failed, platformLinks: lines.join('\\n'), summary, timestamp: new Date().toISOString() } }];"
      }
    },
    {
      "id": "twilio-notify",
      "name": "SMS Zach — Content Live",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2660,
        120
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "twilio-creds",
          "name": "Twilio"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://api.twilio.com/2010-04-01/Accounts/REPLACE_TWILIO_ACCOUNT_SID/Messages.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "To",
              "value": "REPLACE_ZACH_PHONE_E164"
            },
            {
              "name": "From",
              "value": "REPLACE_TWILIO_PHONE_NUMBER"
            },
            {
              "name": "Body",
              "value": "={{ $json.summary }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "log-sheets",
      "name": "Log to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        2660,
        300
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Content Log",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $json.timestamp }}",
            "Total Published": "={{ $json.totalPublished }}",
            "Total Failed": "={{ $json.totalFailed }}",
            "Platform Links": "={{ $json.platformLinks }}"
          }
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Google Drive — New Video": {
      "main": [
        [
          {
            "node": "Parse File Metadata",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse File Metadata": {
      "main": [
        [
          {
            "node": "Vizard — Create Project",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Vizard — Create Project": {
      "main": [
        [
          {
            "node": "Extract Project ID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Project ID": {
      "main": [
        [
          {
            "node": "Wait 3 Minutes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 3 Minutes": {
      "main": [
        [
          {
            "node": "Vizard — Query Clips",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Vizard — Query Clips": {
      "main": [
        [
          {
            "node": "Clips Ready?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Clips Ready?": {
      "main": [
        [
          {
            "node": "Vizard — Get Social Accounts",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait 30s & Retry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 30s & Retry": {
      "main": [
        [
          {
            "node": "Vizard — Query Clips",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Vizard — Get Social Accounts": {
      "main": [
        [
          {
            "node": "Build Publish Tasks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Publish Tasks": {
      "main": [
        [
          {
            "node": "Vizard — Publish Video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Vizard — Publish Video": {
      "main": [
        [
          {
            "node": "Aggregate Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate Results": {
      "main": [
        [
          {
            "node": "SMS Zach — Content Live",
            "type": "main",
            "index": 0
          },
          {
            "node": "Log to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "description": "Drop one edited video in Google Drive -> Vizard AI cuts it into clips -> top clips auto-publish to connected social accounts -> SMS Zach + log to Sheets. Built against the Vizard open-api (elb-api.vizard.ai)."
  }
}
